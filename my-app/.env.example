# ─── Admin Authentication ────────────────────────────────────────────────────
# Admin panel password — change this before deploying!
ADMIN_PASSWORD=ganti-password-ini

# TOTP secret for 2FA — generate a new one for each environment
ADMIN_TOTP_SECRET=ganti-totp-secret-ini

# Session signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=ganti-session-secret-ini

# ─── Admin Host Restriction ──────────────────────────────────────────────────
# Comma-separated list of allowed hostnames for admin access
ADMIN_ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_CANONICAL_URL=http://localhost:3000/admin
NEXT_PUBLIC_ADMIN_CANONICAL_URL=http://localhost:3000/admin

# ─── Redis (Optional) ────────────────────────────────────────────────────────
# If not configured, app uses in-memory fallback (fine for small deployments)
# For Upstash Redis: use the provided host, port, and password
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# ─── HTTPS ────────────────────────────────────────────────────────────────────
# Set to 'true' in production to enable HSTS header
# FORCE_HTTPS=true
